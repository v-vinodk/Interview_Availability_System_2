# ─────────────────────────────────────────────────────────────────────────────
# Streamlit Secrets — copy this file to .streamlit/secrets.toml
# and fill in your real values.
#
# On Streamlit Community Cloud:
#   App Settings → Secrets → paste the contents below
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Service Account for real Google Meet links ─────────────────────────
# Step 1: Go to console.cloud.google.com → Create project "noon-ias"
# Step 2: Enable "Google Calendar API"
# Step 3: IAM & Admin → Service Accounts → Create service account
#         Name: noon-ias-calendar   Role: (none needed)
# Step 4: Keys tab → Add Key → JSON → download the file
# Step 5: In Google Workspace Admin Console:
#         Security → API controls → Domain-wide Delegation → Add new
#         Client ID = service account's "client_id" from the JSON
#         Scopes    = https://www.googleapis.com/auth/calendar
# Step 6: Paste the entire JSON content below as a TOML table:

[GOOGLE_SERVICE_ACCOUNT]
type                        = "service_account"
project_id                  = "your-project-id"
private_key_id              = "key-id-from-json"
private_key                 = "-----BEGIN RSA PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
client_email                = "noon-ias-calendar@your-project-id.iam.gserviceaccount.com"
client_id                   = "123456789012345678901"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/noon-ias-calendar%40your-project-id.iam.gserviceaccount.com"
universe_domain             = "googleapis.com"

# ── If GOOGLE_SERVICE_ACCOUNT is not set, the app automatically falls back  ──
# ── to mock Google Meet links (https://meet.google.com/xxx-xxxx-xxx).       ──
# ── The app works perfectly without this section — just without real links. ──
